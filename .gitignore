# ============ Unity generated folders ============
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Pp]roject[Ss]ettings/
[Pp]ackages/
[Bb]uildPlayer/

# Unity Asset Store tools
[Aa]ssets/AssetStoreTools*/

# ============ Unity generated files ============
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Unity crash and profiling output
[Mm]emoryCaptures/
[Rr]ecordings/

# Assembly definition parser errors
AssemblyDefinitionParserErrors/

# ============ Keep meta files for tracked assets ============
!/[Aa]ssets/**/*.meta

# ============ Visual Studio / VSCode ============
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.userprefs
*.suo
*.cache
omnisharp.json

# ============ OS generated files ============
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============ Build artifacts ============
*.apk
*.aab
*.ipa
*.app
*.exe
*.dmg
build/
.tmp_opening_frames*/

# ============ Logs and local environment ============
.env
.env.*
*.log

# ============ Temporary files ============
*.tmp
*.temp
*.bak
*.orig
TestResults/
.release/
.codex-build/
.dotnet/

# ============ Archives ============
*.zip
*.7z
*.rar

# ============ Git ============
.gitmessage

# ============ Documentation ============
AGENTS.md
GEMINI.md

# ============ MonoGame specific ============
DragonGlare.MonoGame/

# ============ Tools (keep ps1 scripts) ============
!tools/*.ps1

# ============ Assets: exclude specific asset types ============
# フォルダ自体ではなく「中身」を指定し、.meta ファイルだけは除外から除外する
Assets/Sprites/**/*
!Assets/Sprites/**/*.meta

Assets/BGM/**/*
!Assets/BGM/**/*.meta

Assets/SE/**/*
!Assets/SE/**/*.meta

Assets/Textures/**/*
!Assets/Textures/**/*.meta

Assets/Prefabs/**/*
!Assets/Prefabs/**/*.meta

# ============ Assets: exclude generated/converted files ============
# Unity AutoConvert による生成ファイル
Assets/Plugins/MonoBridge/
Assets/Plugins/WebGL/

# 一時アセットファイル（エクスポート等）
ExportedObj/

# AssetBundle 関連（ビルド出力）
*.assetbundle
*.unity3d
AssetBundles/
# ============ Node.js ============
**/node_modules/